@@ -1678,8 +1684,94 @@
 // moveres indicated the physics precision (which is lower for monsters and multiplayer prediction)
 // local is false for multiplayer prediction
 
+// --- A2 movement trace (sauerbraten-revival movement verification) -----------
+// SAUER_TRACE=<path> logs the exact per-5ms ENT_PLAYER state + inputs.
+// SAUER_TRACE.events logs external movement events (map change, jump pads,
+// teleports) so a replay does not diverge at them.
+static FILE *a2tracefile = NULL, *a2eventfile = NULL;
+static bool a2tracechecked = false;
+static int a2tracestep = 0, a2tracetime = 0;
+static void a2traceinit()
+{
+    if(a2tracechecked) return;
+    a2tracechecked = true;
+    const char *path = getenv("SAUER_TRACE");
+    if(!path || !*path) return;
+    a2tracefile = fopen(path, "w");
+    if(a2tracefile) fprintf(a2tracefile,
+        "step,time,move,strafe,jumping,yaw,pitch,ox,oy,oz,vx,vy,vz,fx,fy,fz,physstate,timeinair,floorx,floory,floorz\n");
+    char epath[1024];
+    snprintf(epath, sizeof(epath), "%s.events", path);
+    a2eventfile = fopen(epath, "w");
+    if(a2eventfile) fprintf(a2eventfile, "step,time,event\n");
+}
+static void a2tracelog(physent *pl, int curtime, int jumping)
+{
+    if(!a2tracefile) return;
+    a2tracetime += curtime;
+    fprintf(a2tracefile,
+        "%d,%d,%d,%d,%d,%.4f,%.4f,%.5f,%.5f,%.5f,%.5f,%.5f,%.5f,%.5f,%.5f,%.5f,%d,%d,%.5f,%.5f,%.5f\n",
+        a2tracestep++, a2tracetime, (int)pl->move, (int)pl->strafe, jumping, pl->yaw, pl->pitch,
+        pl->o.x, pl->o.y, pl->o.z, pl->vel.x, pl->vel.y, pl->vel.z,
+        pl->falling.x, pl->falling.y, pl->falling.z,
+        pl->physstate, (int)pl->timeinair, pl->floor.x, pl->floor.y, pl->floor.z);
+}
+// --- A3 clipplane dump: every deformed cube the player's collision touches ----
+// Format:  C <step> <time> <co> <size> <visible> <nplanes> <o> <r> <edges hex>
+//          F <orient> <classifyface> <collideface>
+//          P <i> <nx> <ny> <nz> <offset> <side>
+static FILE *a2clipfile = NULL;
+static bool a2clipchecked = false;
+static void a2traceclip(const cube &c, const ivec &o, int size, const clipplanes &p)
+{
+    if(!a2clipchecked)
+    {
+        a2clipchecked = true;
+        const char *path = getenv("SAUER_TRACE");
+        if(path && *path)
+        {
+            char cp[1024];
+            snprintf(cp, sizeof(cp), "%s.clips", path);
+            a2clipfile = fopen(cp, "w");
+        }
+    }
+    if(!a2clipfile) return;
+    fprintf(a2clipfile, "C %d %d %d %d %d %d %d %d %.4f %.4f %.4f %.4f %.4f %.4f ",
+        a2tracestep, a2tracetime, o.x, o.y, o.z, size, (int)p.visible, (int)p.size,
+        p.o.x, p.o.y, p.o.z, p.r.x, p.r.y, p.r.z);
+    loopi(12) fprintf(a2clipfile, "%02x", c.edges[i]);
+    fprintf(a2clipfile, " %d %d\n", (int)c.material, (int)c.visible);
+    loopi(6)
+    {
+        ivec no; int nsize;
+        const cube &nb = neighbourcube(c, i, o, size, no, nsize);
+        fprintf(a2clipfile, "F %d %d %d %d %d %d %d %d ", i,
+            classifyface(c, i, o, size), collideface(c, i) ? 1 : 0,
+            nsize, (&nb == &c) ? 1 : 0, no.x, no.y, no.z);
+        loopj(12) fprintf(a2clipfile, "%02x", nb.edges[j]);
+        fprintf(a2clipfile, " %d\n", nb.children ? 1 : 0);
+    }
+    loopi(p.size) fprintf(a2clipfile, "P %d %.6f %.6f %.6f %.6f %d\n", i, p.p[i].x, p.p[i].y, p.p[i].z, p.p[i].offset, (int)p.side[i]);
+    fflush(a2clipfile);
+}
+
+void a2traceevent(const char *fmt, ...)
+{
+    a2traceinit();
+    if(!a2eventfile) return;
+    fprintf(a2eventfile, "%d,%d,", a2tracestep, a2tracetime);
+    va_list args;
+    va_start(args, fmt);
+    vfprintf(a2eventfile, fmt, args);
+    va_end(args);
+    fprintf(a2eventfile, "\n");
+    fflush(a2eventfile);
+}
+
 bool moveplayer(physent *pl, int moveres, bool local, int curtime)
 {
+    a2traceinit();
+    int a2jumping = pl->jumping; // capture the jump input before modifyvelocity() consumes it
     int material = lookupmaterial(vec(pl->o.x, pl->o.y, pl->o.z + (3*pl->aboveeye - pl->eyeheight)/4));
     bool water = isliquid(material&MATF_VOLUME);
     bool floating = pl->type==ENT_PLAYER && (pl->state==CS_EDITING || pl->state==CS_SPECTATOR);
@@ -1740,6 +1832,8 @@
     pl->inwater = water ? material&MATF_VOLUME : MAT_AIR;
 
     if(pl->state==CS_ALIVE && (pl->o.z < 0 || material&MAT_DEATH)) game::suicide(pl);
+
+    if(pl->type==ENT_PLAYER) a2tracelog(pl, curtime, a2jumping);
 
     return true;
 }
