 const int MAXCLIPPLANES = 1024;
 static clipplanes clipcache[MAXCLIPPLANES];
@@ -1678,8 +1680,37 @@
 // moveres indicated the physics precision (which is lower for monsters and multiplayer prediction)
 // local is false for multiplayer prediction
 
+// --- A2 movement trace (sauerbraten-revival movement verification) -----------
+// Enabled by setting SAUER_TRACE=<path> in the environment. Logs the exact
+// per-5ms state + inputs for ENT_PLAYER so the port can be diffed against it.
+static FILE *a2tracefile = NULL;
+static bool a2tracechecked = false;
+static int a2tracestep = 0, a2tracetime = 0;
+static void a2traceinit()
+{
+    if(a2tracechecked) return;
+    a2tracechecked = true;
+    const char *path = getenv("SAUER_TRACE");
+    if(!path || !*path) return;
+    a2tracefile = fopen(path, "w");
+    if(a2tracefile) fprintf(a2tracefile,
+        "step,time,move,strafe,jumping,yaw,pitch,ox,oy,oz,vx,vy,vz,fx,fy,fz,physstate,timeinair,floorx,floory,floorz\n");
+}
+static void a2tracelog(physent *pl, int curtime)
+{
+    if(!a2tracefile) return;
+    a2tracetime += curtime;
+    fprintf(a2tracefile,
+        "%d,%d,%d,%d,%d,%.4f,%.4f,%.5f,%.5f,%.5f,%.5f,%.5f,%.5f,%.5f,%.5f,%.5f,%d,%d,%.5f,%.5f,%.5f\n",
+        a2tracestep++, a2tracetime, (int)pl->move, (int)pl->strafe, pl->jumping?1:0, pl->yaw, pl->pitch,
+        pl->o.x, pl->o.y, pl->o.z, pl->vel.x, pl->vel.y, pl->vel.z,
+        pl->falling.x, pl->falling.y, pl->falling.z,
+        pl->physstate, (int)pl->timeinair, pl->floor.x, pl->floor.y, pl->floor.z);
+}
+
 bool moveplayer(physent *pl, int moveres, bool local, int curtime)
 {
+    a2traceinit();
     int material = lookupmaterial(vec(pl->o.x, pl->o.y, pl->o.z + (3*pl->aboveeye - pl->eyeheight)/4));
     bool water = isliquid(material&MATF_VOLUME);
     bool floating = pl->type==ENT_PLAYER && (pl->state==CS_EDITING || pl->state==CS_SPECTATOR);
@@ -1741,6 +1772,8 @@
 
     if(pl->state==CS_ALIVE && (pl->o.z < 0 || material&MAT_DEATH)) game::suicide(pl);
 
+    if(pl->type==ENT_PLAYER) a2tracelog(pl, curtime);
+
     return true;
 }
 
