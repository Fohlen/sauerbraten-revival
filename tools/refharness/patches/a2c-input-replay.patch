+
+// --- A3 deterministic input replay -----------------------------------------
+// SAUER_REPLAY=<trace.csv> feeds a previously recorded A2 trace back into the
+// local player as inputs, so the original re-runs its own physics from the
+// recorded start state. Replaying the same file is bit-identical (A4), and the
+// port can consume the *same* file (test/A3ReplayTest.cs) for an input-replay
+// differential. The file format is exactly the A2 trace written by a2tracelog(),
+// one row per fixed 5 ms local-player step.
+//
+// Column indices: 0 step, 1 time, 2 move, 3 strafe, 4 jumping, 5 yaw, 6 pitch,
+// 7..9 o, 10..12 vel, 13..15 falling, 16 physstate, 17 timeinair, 18..20 floor.
+//
+// Row k holds the state *after* applying row k's inputs from row k-1's state
+// (the same convention test/A3ReplayTest.cs uses). Row 0 is used only as the
+// seed state (it is already a post-step state), so the first physics step
+// applies row 1's inputs: replay output row k matches input row k+1.
+//
+// The replay is FREE-RUNNING: state is restored only from row 0, and thereafter
+// only the inputs are fed in, so the engine must regenerate the whole trajectory
+// by itself. A trace the original reproduces free-running is a *stable* fixture.
+static FILE *a2replayfile = NULL;
+static bool a2replaychecked = false, a2replayeof = false, a2replayfirst = true;
+static float a2replayrow[21], a2replayprev[21];
+
+static bool a2replayparse(char *line, float *row)
+{
+    if(line[0] < '0' || line[0] > '9') return false; // header / blank
+    int n = 0;
+    char *p = line;
+    while(n < 21)
+    {
+        char *end;
+        row[n++] = strtof(p, &end);
+        if(end == p || *end != ',') break;
+        p = end + 1;
+    }
+    return n == 21;
+}
+
+static void a2replayrestore(physent *pl, const float *row)
+{
+    pl->o = vec(row[7], row[8], row[9]);
+    pl->vel = vec(row[10], row[11], row[12]);
+    pl->falling = vec(row[13], row[14], row[15]);
+    pl->physstate = (uchar)row[16];
+    pl->timeinair = (ushort)row[17];
+    pl->floor = vec(row[18], row[19], row[20]);
+    pl->resetinterp();
+}
+
+static bool a2replayapply(physent *pl)
+{
+    if(!a2replaychecked)
+    {
+        a2replaychecked = true;
+        const char *path = getenv("SAUER_REPLAY");
+        if(path && *path) a2replayfile = fopen(path, "r");
+    }
+    if(!a2replayfile || a2replayeof) return false;
+    char line[4096];
+    if(a2replayfirst)
+    {
+        a2replayfirst = false;
+        while(fgets(line, sizeof(line), a2replayfile)) if(a2replayparse(line, a2replayprev)) break;
+        if(feof(a2replayfile)) { a2replayeof = true; return false; }
+        a2replayrestore(pl, a2replayprev);
+    }
+    while(fgets(line, sizeof(line), a2replayfile)) if(a2replayparse(line, a2replayrow)) break;
+    if(feof(a2replayfile)) { a2replayeof = true; return false; }
+    pl->move = (schar)a2replayrow[2];
+    pl->strafe = (schar)a2replayrow[3];
+    pl->jumping = a2replayrow[4] != 0;
+    pl->yaw = a2replayrow[5];
+    pl->pitch = a2replayrow[6];
+    loopi(21) a2replayprev[i] = a2replayrow[i];
+    return true;
 }
 
