+// --- A2 input/timing trace (sauerbraten-revival movement verification) -------
+// SAUER_INPUTTRACE=<path> logs the input + scheduling layer, so the port can
+// reproduce it exactly:
+//   I <seq> <dx> <dy> <curtime> <sensitivity> <yaw> <pitch>
+//       one line per mouse-look application (once per rendered frame, with the
+//       whole frame's SDL_MOUSEMOTION delta already summed). `curtime` at the
+//       time of the mouse event lets us recover mouseaccel (needs curtime).
+//   T <seq> <elapsedtime> <scaledtime> <curtime> <timeerr>
+//       the main-loop timeline, once per rendered frame.
+//   P <seq> <diff> <physframetime> <physsteps>
+//       the physics scheduler output, once per physicsframe().
+static FILE *a2inputfile = NULL;
+static bool a2inputchecked = false;
+static int a2inputseq = 0;
+static void a2inputinit()
+{
+    if(a2inputchecked) return;
+    a2inputchecked = true;
+    const char *path = getenv("SAUER_INPUTTRACE");
+    if(!path || !*path) return;
+    a2inputfile = fopen(path, "w");
+    if(a2inputfile) fprintf(a2inputfile, "kind,seq,a,b,c,d,e,f\n");
+}
+static void a2inputwriteln(const char *kind, long a, long b, long c, double d, double e, double f)
+{
+    if(!a2inputfile) return;
+    fprintf(a2inputfile, "%s,%d,%ld,%ld,%ld,%.4f,%.4f,%.4f\n", kind, a2inputseq++, a, b, c, d, e, f);
+    fflush(a2inputfile);
+}
+void a2inputlog(int dx, int dy, float cursens, float yaw, float pitch)
+{
+    a2inputinit();
+    // a=dx b=dy c=curtime, d=cursens, e=yaw, f=pitch
+    a2inputwriteln("I", dx, dy, (long)curtime, cursens, yaw, pitch);
+}
+void a2timelog(int elapsedtime, int scaledtime, int curtime, int timeerr)
+{
+    a2inputinit();
+    a2inputwriteln("T", elapsedtime, scaledtime, curtime, timeerr, 0, 0);
+}
+void a2physlog(int diff, int physframetime, int physsteps)
+{
+    a2inputinit();
+    a2inputwriteln("P", diff, physframetime, physsteps, 0, 0, 0);
+}
+
 bool moveplayer(physent *pl, int moveres, bool local, int curtime)
