<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <RootNamespace>SauerbratenRevival.Tools.DmoReader</RootNamespace>
    <AssemblyName>dmoreader</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FlatSharp.Runtime" Version="7.9.0" />
    <PackageReference Include="FlatSharp.Compiler" Version="7.9.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../World/Demo/Formats/Dmo/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <FlatSharpSchema Include="../../World/Schema/schema.fbs" />
  </ItemGroup>
</Project>
