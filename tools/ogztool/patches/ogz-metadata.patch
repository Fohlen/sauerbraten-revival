+// metadata.cpp: one-time OGZ import metadata export (sauerbraten-revival)
+//
+// This file is added by a patch to Sauerbraten SVN r6889 and is not part of the
+// original engine. When SAUER_METADATA is set to an output path, loading a map
+// writes a JSON description of the resolved texture slots, variant slots,
+// mapmodels, entities and map sounds to that path. The offline OGZ importer
+// consumes this JSON to turn stored indices back into asset paths.
+//
+// See docs/ogz-import.md for the pipeline this feeds.
+
+#include "engine.h"
+
+#ifndef STANDALONE
+
+static void jsonstring(FILE *f, const char *s)
+{
+    fputc('"', f);
+    if(s) for(const char *p = s; *p; p++)
+    {
+        unsigned char c = (unsigned char)*p;
+        switch(c)
+        {
+            case '"':  fputs("\\\"", f); break;
+            case '\\': fputs("\\\\", f); break;
+            case '\n': fputs("\\n", f); break;
+            case '\r': fputs("\\r", f); break;
+            case '\t': fputs("\\t", f); break;
+            default:
+                if(c < 0x20) fprintf(f, "\\u%04x", c);
+                else fputc(c, f);
+                break;
+        }
+    }
+    fputc('"', f);
+}
+
+// JSON has no Infinity/NaN: emit null for any non-finite value (e.g. a vslot
+// with an infinite scroll, used to mean "no scroll"). Checked on the raw bit
+// pattern; this file is compiled with -fno-finite-math-only (see Makefile) so
+// the check is not folded away under the engine's -ffast-math.
+static void jsonfloat(FILE *f, float v)
+{
+    unsigned int bits;
+    memcpy(&bits, &v, sizeof(bits));
+    if((bits & 0x7F800000u) != 0x7F800000u) fprintf(f, "%g", v); // exponent all-ones = inf/nan
+    else fputs("null", f);
+}
+
+static void jsonparams(FILE *f, const vector<SlotShaderParam> &params)
+{
+    fputc('[', f);
+    loopv(params)
+    {
+        const SlotShaderParam &p = params[i];
+        if(i) fputc(',', f);
+        fputs("{\"name\":", f); jsonstring(f, p.name);
+        fputs(",\"val\":[", f);
+        loopk(4) { if(k) fputc(',', f); jsonfloat(f, p.val[k]); }
+        fputs("]}", f);
+    }
+    fputc(']', f);
+}
+
+static const char *slottextypename(int type)
+{
+    switch(type)
+    {
+        case TEX_DIFFUSE: return "diffuse";
+        case TEX_UNKNOWN: return "unknown";
+        case TEX_DECAL:   return "decal";
+        case TEX_NORMAL:  return "normal";
+        case TEX_GLOW:    return "glow";
+        case TEX_SPEC:    return "spec";
+        case TEX_DEPTH:   return "depth";
+        case TEX_ALPHA:   return "alpha";
+        case TEX_ENVMAP:  return "envmap";
+        default:          return "unknown";
+    }
+}
+
+// The engine registers every texture from every exec'd package.cfg, so `slots`
+// is the full *available* set, not the set the map uses. Walk the octree the
+// same way compactvslots() does and mark the vslots the geometry references
+// (plus any layer vslots they point at).
+static void markusedvslots(cube *c, int n, vector<uchar> &used)
+{
+    loopi(n)
+    {
+        if(c[i].children) markusedvslots(c[i].children, 8, used);
+        else loopj(6)
+        {
+            ushort t = c[i].texture[j];
+            if(vslots.inrange(t)) used[t] = 1;
+        }
+    }
+}
+
+// Geometry ground truth for the OGZ reader tests: the cube-tree shape, leaf
+// classification, texture assignment and a checksum over the canonical cube
+// fields a reader reconstructs from the file. FNV-1a/64 over, per node:
+//   0x00                                  (internal node)
+//   0x01/0x02/0x03 + material + 6 textures  (empty/solid/normal leaf)
+//   + 12 edge bytes for normal leaves
+// `merged` is excluded because allchanged() recomputes it after load.
+static void hashbyte64(unsigned long long &h, uchar b) { h = (h ^ b) * 1099511628211ULL; }
+static void hashushort64(unsigned long long &h, ushort v)
+{
+    hashbyte64(h, uchar(v & 0xFF));
+    hashbyte64(h, uchar((v >> 8) & 0xFF));
+}
+static void geometrywalk(cube *c, int n, int &nodes, int &leaves, int &empty, int &solid, int &normal,
+                         int &surfaces, int &verts, vector<int> &texcounts, unsigned long long &hash)
+{
+    loopi(n)
+    {
+        if(c[i].children)
+        {
+            nodes++;
+            hashbyte64(hash, 0);
+            geometrywalk(c[i].children, 8, nodes, leaves, empty, solid, normal, surfaces, verts, texcounts, hash);
+        }
+        else
+        {
+            leaves++;
+            uchar type;
+            if(isempty(c[i])) { type = 1; empty++; }
+            else if(isentirelysolid(c[i])) { type = 2; solid++; }
+            else { type = 3; normal++; }
+            if(c[i].ext) loopj(6)
+            {
+                // Not gated on surf.used(): initlights() may have set lmids on faces
+                // that carry no geometry, whereas totalverts() is exactly the vertex
+                // count reconstructed from the file.
+                int totalverts = c[i].ext->surfaces[j].totalverts();
+                if(totalverts > 0) surfaces++;
+                verts += totalverts;
+            }
+            hashbyte64(hash, type);
+            hashushort64(hash, c[i].material);
+            loopj(6)
+            {
+                ushort t = c[i].texture[j];
+                if(texcounts.inrange(t)) texcounts[t]++;
+                hashushort64(hash, t);
+            }
+            if(type == 3) loopj(12) hashbyte64(hash, c[i].edges[j]);
+        }
+    }
+}
+
+void exportmapmetadata(const char *mapname)
+{
+    const char *out = getenv("SAUER_METADATA");
+    if(!out || !*out) return;
+    FILE *f = fopen(out, "w");
+    if(!f) { conoutf(CON_WARN, "could not write map metadata to %s", out); return; }
+
+    vector<uchar> usedvslots;
+    loopv(vslots) usedvslots.add(0);
+    markusedvslots(worldroot, 8, usedvslots);
+    loopv(vslots)
+    {
+        if(!usedvslots[i]) continue;
+        int layer = vslots[i]->layer, guard = 0;
+        while(layer && vslots.inrange(layer) && !usedvslots[layer] && guard++ < 64)
+        {
+            usedvslots[layer] = 1;
+            layer = vslots[layer]->layer;
+        }
+    }
+    vector<uchar> usedslots;
+    loopv(slots) usedslots.add(0);
+    loopv(vslots) if(usedvslots[i] && vslots[i]->slot)
+    {
+        int index = vslots[i]->slot->index;
+        if(slots.inrange(index)) usedslots[index] = 1;
+    }
+    int numusedvslots = 0, numusedslots = 0;
+    loopv(usedvslots) if(usedvslots[i]) numusedvslots++;
+    loopv(usedslots) if(usedslots[i]) numusedslots++;
+
+    int gnodes = 0, gleaves = 0, gempty = 0, gsolid = 0, gnormal = 0, gsurfaces = 0, gverts = 0;
+    unsigned long long ghash = 14695981039346656037ULL;
+    vector<int> gtexcounts;
+    loopv(vslots) gtexcounts.add(0);
+    geometrywalk(worldroot, 8, gnodes, gleaves, gempty, gsolid, gnormal, gsurfaces, gverts, gtexcounts, ghash);
+
+    // Mapmodels are registered the same way (default_map_models.cfg lists every
+    // available model). Only a handful are placed by the map, so resolve just
+    // the ones its entities reference.
+    vector<extentity *> &ents = entities::getents();
+    vector<int> usedmodels;
+    loopv(ents)
+    {
+        extentity &e = *ents[i];
+        const char *type = entities::entname(e.type);
+        int model = e.type == ET_MAPMODEL ? e.attr2
+                  : !strcmp(type, "teleport") && e.attr2 > 0 ? e.attr2 : -1;
+        if(model >= 0 && mapmodelname(model) && usedmodels.find(model) < 0) usedmodels.add(model);
+    }
+    usedmodels.sort();
+    int nummapmodels = 0;
+    while(mapmodelname(nummapmodels)) nummapmodels++;
+
+    // Map sounds are already map-scoped (cleared by resetmap(), then redefined
+    // by the map's cfg), but a map can still define more than its entities use.
+    // Sound indices live on ET_SOUND.attr1 and on JUMPPAD/TELEPORT.attr4 (the
+    // latter are fpsgame-specific, so match on the engine's type name).
+    vector<int> usedsounds;
+    loopv(ents)
+    {
+        extentity &e = *ents[i];
+        int sound = e.type == ET_SOUND ? e.attr1 : -1;
+        if(sound < 0 && e.attr4 > 0)
+        {
+            const char *type = entities::entname(e.type);
+            if(!strcmp(type, "jumppad") || !strcmp(type, "teleport")) sound = e.attr4;
+        }
+        if(sound >= 0 && mapsoundname(sound) && usedsounds.find(sound) < 0) usedsounds.add(sound);
+    }
+    usedsounds.sort();
+    int nummapsounds = 0;
+    while(mapsoundname(nummapsounds)) nummapsounds++;
+
+    fprintf(f, "{\n");
+    fputs("\"mapname\":", f); jsonstring(f, mapname); fputs(",\n", f);
+    fprintf(f, "\"worldsize\":%d,\n", worldsize);
+
+    fputs("\"geometry\":{\n", f);
+    fprintf(f, "\"nodes\":%d,\"leaves\":%d,\"empty\":%d,\"solid\":%d,\"normal\":%d,\n",
+            gnodes, gleaves, gempty, gsolid, gnormal);
+    fprintf(f, "\"surfaces\":%d,\"verts\":%d,\n", gsurfaces, gverts);
+    fprintf(f, "\"checksum\":\"%016llx\",\n", ghash);
+    fputs("\"textureFaces\":[", f);
+    {
+        bool firsttex = true;
+        loopv(gtexcounts) if(gtexcounts[i])
+        {
+            if(!firsttex) fputc(',', f);
+            firsttex = false;
+            fprintf(f, "{\"texture\":%d,\"count\":%d}", i, gtexcounts[i]);
+        }
+    }
+    fputs("]\n},\n", f);
+
+    fputs("\"slots\":[\n", f);
+    bool firstslot = true;
+    loopv(slots)
+    {
+        if(!usedslots[i]) continue;
+        Slot &s = *slots[i];
+        if(!firstslot) fputs(",\n", f);
+        firstslot = false;
+        fprintf(f, "{\"index\":%d", s.index);
+        fputs(",\"textures\":[", f);
+        loopvj(s.sts)
+        {
+            Slot::Tex &t = s.sts[j];
+            if(j) fputc(',', f);
+            fputs("{\"type\":", f); jsonstring(f, slottextypename(t.type));
+            fputs(",\"path\":", f); jsonstring(f, t.name);
+            fputc('}', f);
+        }
+        fputs("],\"shader\":", f);
+        jsonstring(f, s.shader ? s.shader->name : NULL);
+        fputs(",\"params\":", f);
+        jsonparams(f, s.params);
+        fputc('}', f);
+    }
+    fputs("\n],\n", f);
+
+    fputs("\"vslots\":[\n", f);
+    bool firstvslot = true;
+    loopv(vslots)
+    {
+        if(!usedvslots[i]) continue;
+        VSlot &v = *vslots[i];
+        if(!firstvslot) fputs(",\n", f);
+        firstvslot = false;
+        fprintf(f, "{\"index\":%d,\"slot\":%d", v.index, v.slot ? v.slot->index : -1);
+        fputs(",\"scale\":", f); jsonfloat(f, v.scale);
+        fprintf(f, ",\"rotation\":%d", v.rotation);
+        fprintf(f, ",\"offset\":[%d,%d]", v.offset.x, v.offset.y);
+        fputs(",\"scroll\":[", f); jsonfloat(f, v.scroll.x); fputc(',', f); jsonfloat(f, v.scroll.y); fputc(']', f);
+        fprintf(f, ",\"layer\":%d", v.layer);
+        fputs(",\"alpha\":[", f); jsonfloat(f, v.alphafront); fputc(',', f); jsonfloat(f, v.alphaback); fputc(']', f);
+        fputs(",\"color\":[", f); jsonfloat(f, v.colorscale.x); fputc(',', f); jsonfloat(f, v.colorscale.y); fputc(',', f); jsonfloat(f, v.colorscale.z); fputc(']', f);
+        fputs(",\"glow\":[", f); jsonfloat(f, v.glowcolor.x); fputc(',', f); jsonfloat(f, v.glowcolor.y); fputc(',', f); jsonfloat(f, v.glowcolor.z); fputc(']', f);
+        fputs(",\"params\":", f);
+        jsonparams(f, v.params);
+        fputc('}', f);
+    }
+    fputs("\n],\n", f);
+
+    fputs("\"mapmodels\":[\n", f);
+    bool firstmodel = true;
+    loopv(usedmodels)
+    {
+        int index = usedmodels[i];
+        if(!firstmodel) fputs(",\n", f);
+        firstmodel = false;
+        fprintf(f, "{\"index\":%d,\"path\":", index);
+        jsonstring(f, mapmodelname(index));
+        fputc('}', f);
+    }
+    fputs("\n],\n", f);
+
+    fputs("\"entities\":[\n", f);
+    loopv(ents)
+    {
+        extentity &e = *ents[i];
+        if(i) fputs(",\n", f);
+        fprintf(f, "{\"index\":%d,\"type\":", i);
+        jsonstring(f, entities::entname(e.type));
+        fputs(",\"position\":[", f); jsonfloat(f, e.o.x); fputc(',', f); jsonfloat(f, e.o.y); fputc(',', f); jsonfloat(f, e.o.z); fputc(']', f);
+        fprintf(f, ",\"attr1\":%d,\"attr2\":%d,\"attr3\":%d,\"attr4\":%d,\"attr5\":%d",
+                e.attr1, e.attr2, e.attr3, e.attr4, e.attr5);
+        fputc('}', f);
+    }
+    fputs("\n],\n", f);
+
+    fputs("\"sounds\":[\n", f);
+    bool firstsound = true;
+    loopv(usedsounds)
+    {
+        int index = usedsounds[i];
+        if(!firstsound) fputs(",\n", f);
+        firstsound = false;
+        fprintf(f, "{\"index\":%d,\"path\":", index);
+        jsonstring(f, mapsoundname(index));
+        fputc('}', f);
+    }
+    fputs("\n]\n}\n", f);
+
+    fclose(f);
+    conoutf("exported map metadata to %s (%d/%d slots, %d/%d vslots, %d/%d mapmodels, %d/%d sounds used)", out, numusedslots, slots.length(), numusedvslots, vslots.length(), usedmodels.length(), nummapmodels, usedsounds.length(), nummapsounds);
+}
+
+#endif
