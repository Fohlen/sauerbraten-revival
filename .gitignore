# Godot 4+ specific ignores
.godot/
/android/

# .NET / Godot C# build output
.mono/
bin/
obj/
.vs/
*.user

# Rider
.idea/

# Ignore Python output
__pycache__

# native reference harness artifacts
tools/refharness/refharness
tools/refharness/out/
tools/refharness/instrumented/build/

# ogz tooling client + build tree (regenerated by tools/ogztool/build.sh)
tools/ogztool/out/

# normalized v33 maps produced by tools/ogztool/convert-all-maps.sh
# imported legacy textures (regenerated by tools/texture-import)
# imported legacy sounds
assets/

# saved maps
*.bin

# octree ground-truth probe binary
tools/octaprobe/octaprobe

# raycube ground-truth probe binary
tools/rayprobe/rayprobe

# MD5 animation ground-truth probe binary
tools/animprobe/animprobe

# assimp-converted mapmodels (regenerated by tools/model-import)
tools/model-import/out/

# OSX
.DS_Store

# generated import lightmap assets
*.import
