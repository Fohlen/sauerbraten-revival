# imported legacy sounds
assets/
assets

# saved maps (the shipped canonical empty_map package is tracked: ADR 0009)
*.bin
!resources/maps/empty_map/map.bin

# octree ground-truth probe binary
tools/octaprobe/octaprobe

# raycube ground-truth probe binary
tools/rayprobe/rayprobe

# MD5 animation ground-truth probe binary
tools/animprobe/animprobe

# dmo demo ground-truth probe binary
tools/dmoprobe/dmoprobe
tools/predictprobe/predictprobe

# assimp-converted mapmodels (regenerated by tools/model-import)
tools/model-import/out/

# botlab datasets, checkpoints and exported ONNX models (regenerated by tools/botlab)
tools/botlab/out/

# OSX
.DS_Store

# generated import lightmap assets
*.import
