namespace SauerbratenRevival.Format;

attribute "fs_serializer";

enum WorldOp : ubyte {
    None = 0,
    DeleteCube = 1,
    EditFace = 2,
    SetFaceTexture = 3,
    ReplaceTexture = 4,
    SetFaceMaterial = 5,
    FlipCube = 6,
    RotateCube = 7,
    Remip = 20,
    NewMap = 30,
    AddEntity = 40,
    RemoveEntity = 41,
    EditEntity = 42,
    SetEnvironment = 43,
    ReplaceBlock = 50,
    PlayerUpdate = 60,
    PlayerSpawn = 61,
    PlayerDeath = 62,
    PlayerTeleport = 63,
    PlayerJumpPad = 64,
    PlayerDamage = 65
}

struct Vec3i {
    x: int32;
    y: int32;
    z: int32;
}

struct Vec3f {
    x: float32;
    y: float32;
    z: float32;
}

struct SelectionBox {
    origin: Vec3i;
    size: Vec3i;
    grid: int32;
    orient: int32;
}

table EditFaceCmd {
    sel: SelectionBox;
    dir: int32;
    mode: int32;
    stride: int32;
}

table SetTextureCmd {
    sel: SelectionBox;
    texture_id: int32;
    flags: int32;
}

table ReplaceTextureCmd {
    sel: SelectionBox;
    old_texture: int16;
    new_texture: int16;
    in_selection: bool;
}

table DeleteCubeCmd {
    sel: SelectionBox;
}

table RemipCmd {
    mip_vis: bool;
}

table FlipCubeCmd {
    sel: SelectionBox;
}

table RotateCubeCmd {
    sel: SelectionBox;
    direction: int32;
}

table EntityCmd {
    entity_id: uint64;
    type: int32;
    pos: Vec3i;
    attr1: int32;
    attr2: int32;
    attr3: int32;
    attr4: int32;
    attr5: int32;
}

table SetEnvironmentCmd {
    sun_color: uint32;               // 0xRRGGBB packed hex (sunlight)
    sun_scale: float32;              // Intensity multiplier (sunlightscale)
    sun_yaw: float32;                // Direction yaw in degrees (sunlightyaw)
    sun_pitch: float32;              // Direction pitch in degrees (sunlightpitch)
    sky_color: uint32;               // 0xRRGGBB (skylight)
    ambient_color: uint32;           // 0xRRGGBB (ambient)
    skybox: string;                  // Cubemap texture prefix/path
    fog_distance: float32;           // Fog view distance in world units
    fog_color: uint32;               // 0xRRGGBB (fogcolour)
}

table SetMaterialCmd {
    sel: SelectionBox;
    material_id: int32;
    filter: int32;
}

table NewMapCmd {
    scale: int32;
}

table ReplaceBlockCmd {
    sel: SelectionBox;
    data: [ubyte];
}

table PlayerUpdateCmd (fs_serializer) {
    tick: int32;
    move: int32;
    strafe: int32;
    jumping: bool;
    yaw: float32;
    pitch: float32;
    attacking: bool;
    selected_gun: int32;
    
    // Authoritative kinematic state (for reconciliation, verification, and drift checks)
    pos: Vec3f;
    vel: Vec3f;
    phys_state: ubyte;
    life_sequence: int32;
}

table PlayerSpawnCmd {
    pos: Vec3f;
    yaw: float32;
    life_sequence: int32;
    selected_gun: int32;
    health: int32 = 100;
    armour: int32 = 0;
    ammo: [int32];
}

table PlayerDeathCmd {
    victim_peer_id: int32;
    killer_peer_id: int32;
    gun: int32;
    is_suicide: bool;
    death_pos: Vec3f;
    impulse: Vec3f;
}

table PlayerTeleportCmd {
    teleport_id: int32;
    dest_pos: Vec3f;
    dest_yaw: float32;
}

table PlayerJumpPadCmd {
    pad_id: int32;
    impulse: Vec3f;
}

table PlayerDamageCmd {
    target_peer_id: int32;
    actor_peer_id: int32;
    damage: int32;
    armour: int32;
    health: int32;
}

union CommandPayload {
    EditFaceCmd,
    SetTextureCmd,
    ReplaceTextureCmd,
    DeleteCubeCmd,
    RemipCmd,
    FlipCubeCmd,
    RotateCubeCmd,
    EntityCmd,
    SetEnvironmentCmd,
    SetMaterialCmd,
    NewMapCmd,
    ReplaceBlockCmd,
    PlayerUpdateCmd,
    PlayerSpawnCmd,
    PlayerDeathCmd,
    PlayerTeleportCmd,
    PlayerJumpPadCmd,
    PlayerDamageCmd
}

table Command (fs_serializer) {
    sequence: uint64;
    peer_id: int32;
    timestamp: uint32;
    op: WorldOp;
    payload: CommandPayload;
}

table ChunkKeyframe {
    chunk_index: ubyte;              // 0..7
    uncompressed_size: uint32;
    node_count: uint32;
    data: [ubyte];                   // Dense pre-order cube stream
}

table KeyframePackage (fs_serializer) {
    keyframe_index: uint32;
    format_version: uint32 = 1;
    world_scale: int32;
    git_commit: string;              // Git commit SHA pegging keyframe to clean repository state
    base_snapshot_hash: [ubyte];     // 32-byte SHA-256
    chunks: [ChunkKeyframe];
    entities: [EntityCmd];
    environment: SetEnvironmentCmd;  // Authoritative lighting & skybox state
}

table MapPackage (fs_serializer) {
    format_version: uint32 = 1;
    map_name: string;
    author: string;
    base_map_hash: [ubyte];          // 32-byte SHA-256 if diff package, empty if standalone
    
    keyframes: [KeyframePackage];    // Intermediary snapshots taken at remip / milestones
    deltas: [Command];               // Commands applied since the latest keyframe
    entities: [EntityCmd];           // Active world entities
    environment: SetEnvironmentCmd;  // Baseline map environment
}

table NetworkPacket (fs_serializer) {
    packet_id: uint32;
    commands: [Command];
}

table DemoPeerInfo {
    peer_id: int32;
    name: string;
    team: string;
    playermodel: int32;
}

table DemoPackage (fs_serializer) {
    format_version: uint32 = 1;
    map_name: string;
    game_mode: string;
    initial_spawn_pos: Vec3f;
    initial_spawn_yaw: float32;
    commands: [Command];
    peers: [DemoPeerInfo];
}

root_type MapPackage;
