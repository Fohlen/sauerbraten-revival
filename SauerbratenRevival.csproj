<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>SauerbratenRevival</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- Test sources are excluded from exported/release builds. -->
    <DefaultItemExcludes Condition="'$(Configuration)' == 'ExportRelease'">$(DefaultItemExcludes);test/**/*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- tools/ holds dev-only projects (C++ harness); not part of the game assembly. -->
    <Compile Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- GoDotTest runs the unit tests inside the Godot runtime (see test/). -->
    <PackageReference Include="Chickensoft.GoDotTest" Version="2.0.47" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
  </ItemGroup>
</Project>
